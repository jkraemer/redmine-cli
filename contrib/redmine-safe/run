#!/bin/sh
# Runs as redmine-svc via sudo. Starts the root-owned redmine-cli copy in
# locked mode with a cleared environment; the API key stays in
# /home/redmine-svc/.config/redmine-cli/config.toml. Every command here must
# be an absolute path: sudo keeps the caller's PATH unless secure_path is set.
cd / || exit 1
exec /usr/bin/env -i HOME=/home/redmine-svc PATH=/usr/bin:/bin REDMINE_LOCKED=1 \
  /usr/local/libexec/redmine-safe/redmine-cli "$@"
